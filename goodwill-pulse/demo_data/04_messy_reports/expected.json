      "orders_in_file": 40
    },
    "paid_orders_10-02-2026_10-02-2026 (3).csv": {
      "should_catch": [
        "file name says 2026-10-02 but the paid dates are 2026-10-01"
      ],
      "orders_in_file": 25
    },
    "paid_orders_10-02-2026_10-02-2026 (4).csv": {
      "should_catch": [
        "identical to file (3): already loaded"
      ]
    },
    "NO_CASH_MONKEY_FILE.txt": {
