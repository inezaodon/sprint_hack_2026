        "1 blank buyer"
      ],
      "orders_after_cleanup": 92,
      "item_sales_after_cleanup": 12041.31
    },
    "paid_orders_title_rows_10-02-2026.xlsx": {
      "should_catch": [
        "3 title rows before the header",
        "one text date, one invalid date",
        "totals row"
